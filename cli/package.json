{
  "name": "stupid-upload",
  "version": "0.0.2",
  "description": "CLI for the Stupid Upload service: quote, upload (temp/free or permanent/x402 paid), status, list, download, delete, and feedback. Node.",
  "keywords": [
    "agent",
    "cloudflare",
    "file-sharing",
    "r2",
    "upload",
    "x402"
  ],
  "homepage": "https://upload.stupidtech.net",
  "bugs": "https://github.com/stephancill/stupid-upload/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephancill/stupid-upload.git",
    "directory": "cli"
  },
  "bin": {
    "stupid-upload": "dist/stupid-upload.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@x402/core": "^2.24.0",
    "@x402/evm": "^2.24.0",
    "@x402/fetch": "^2.24.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
