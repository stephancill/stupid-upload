# Copy to .dev.vars for local development. Never commit .env or .env.local.
# Production values are set via `wrangler secret put` and CI secrets.

# Base URL of the API/site origin.
# STUPID_UPLOAD_BASE_URL=https://upload.stupidtech.net

# Separate host that serves untrusted files. Leave unset to fall back to the base host.
# STUPID_UPLOAD_FILES_HOST=https://files.upload.stupidtech.net

# High-entropy HMAC secret for hashing request sources, idempotency tokens, and recovery tokens.
# Generate with: openssl rand -hex 32
STUPID_UPLOAD_HMAC_SECRET=

# Secret protecting the admin deletion endpoint. Generate with: openssl rand -hex 32
STUPID_UPLOAD_ADMIN_SECRET=

# Global daily quota (bytes) reserved for all temporary upload reservations per UTC day.
# Defaults to 10 GiB.
# STUPID_UPLOAD_GLOBAL_DAILY_QUOTA_BYTES=10737418240

# Per-source daily quota (bytes) for temporary upload reservations per UTC day. Defaults to 20 MiB.
# STUPID_UPLOAD_SOURCE_DAILY_QUOTA_BYTES=20971520

# Global daily circuit breaker for feedback submissions per UTC day. Defaults to 1000.
# STUPID_UPLOAD_FEEDBACK_GLOBAL_DAILY_LIMIT=1000

# Per-source daily feedback submissions per UTC day. Defaults to 20.
# STUPID_UPLOAD_FEEDBACK_SOURCE_DAILY_LIMIT=20

# Feedback record retention in seconds before scheduled purge. Defaults to 365 days.
# STUPID_UPLOAD_FEEDBACK_RETENTION_SECONDS=31536000

# Tombstone retention for deleted/expired upload rows before metadata purge. Defaults to 7 days.
# STUPID_UPLOAD_TOMBSTONE_RETENTION_SECONDS=604800

# Pending reservation lifetime in seconds. Defaults to 900 (15 minutes).
# STUPID_UPLOAD_PENDING_LIFETIME_SECONDS=900

# --- x402 permanent uploads (Phase 4) ---
# Master switch for the paid permanent tier. Defaults to false. Deleting the
# secret/variable is how you turn it off (the value is parsed string-safely).
# STUPID_UPLOAD_PERMANENT_PAYMENT_ENABLED=false

# Coinbase CDP hosted facilitator credentials. When set, the worker uses the
# CDP facilitator (requires the payment network + recipient below); otherwise
# a generic facilitator URL may be used.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Base URL of a generic x402 facilitator (its /verify /settle /supported
# endpoints). Ignored when CDP credentials above are set.
# STUPID_UPLOAD_FACILITATOR_URL=

# Payment network: Base Sepolia (test) eip155:84532 or Base (prod) eip155:8453.
# STUPID_UPLOAD_PAYMENT_NETWORK=eip155:84532

# Recipient of settled permanent payments (0x...).
# STUPID_UPLOAD_PAYMENT_ADDRESS=