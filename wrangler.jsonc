// Cloudflare Worker configuration for Stupid Upload
{
  "name": "stupid-upload",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "upload.stupidtech.net", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public"
  },
  "vars": {
    "STUPID_UPLOAD_BASE_URL": "https://upload.stupidtech.net",
    "STUPID_UPLOAD_FILES_HOST": "https://upload.stupidtech.net",
    "STUPID_UPLOAD_GLOBAL_DAILY_QUOTA_BYTES": "10737418240"
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "stupid-upload"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stupid-upload",
      "database_id": "53ad3cc3-7b9c-459f-a990-0a807173f1b6",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
